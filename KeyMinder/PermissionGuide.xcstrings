{
  "sourceLanguage" : "en",
  "strings" : {
    "Access granted" : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zugriff erteilt"
          }
        }
      }
    },
    "All Apps (recommended)" : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Apps (empfohlen)"
          }
        }
      }
    },
    "Apps start as Ask First: the first time KeyMinder reads one, macOS asks you, and the permission lasts until the next day. Choose At Any Time for an app so macOS stops asking." : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apps starten mit „Ask First“: Wenn KeyMinder eine App zum ersten Mal liest, fragt macOS nach, und die Erlaubnis gilt bis zum nächsten Tag. Wählen Sie für eine App „At Any Time“, damit macOS nicht mehr fragt."
          }
        }
      }
    },
    "Back" : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurück"
          }
        }
      }
    },
    "Click + in System & App Protection Override" : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicken Sie in „System & App Protection Override“ auf +"
          }
        }
      }
    },
    "Click + to add apps" : {
      "comment" : "Permission guide for macOS 27.3+. Screenshots stay English; German only so far, other languages fall back to English.",
      "shouldTranslate" : false,
      "localizations" : {
        "de" : {
