# Profile for dev (~/Developer/_DevOps). Data only: never sourced. Public repo: no secrets here.
NAME=KeyMinder
BUNDLE_ID=org.afaik.KeyMinder
PROJECT=KeyMinder.xcodeproj
SCHEME_MACOS=KeyMinder
PLATFORMS=macos
DISTRIBUTION=direct
UPDATES=sparkle
PACKAGES="zip dmg cask"
CDN=cloudflare
REPO_VISIBILITY=public
NOTARY_PROFILE=KeyMinder
# Until its sections move into dev (Phase 9 step B), dev alpha|beta|release run preflight, ask,
# then scripts/release.sh --alpha|--beta|--remote-only.
RELEASE_SCRIPT=scripts/release.sh
APPCAST=Distribution/appcast.xml
CASK_FILE=Distribution/Casks/keyminder.rb
# Sparkle tools (dev setup sparkle), the same version as Package.resolved.
SPARKLE_VERSION=2.9.2
SPARKLE_SHA256=1cb340cbbef04c6c0d162078610c25e2221031d794a3449d89f2f56f4df77c95
CHANNEL_BUILD_SETTING=KM_RELEASE_CHANNEL
ENV_FILE=.config/scripts/.env
PROVISIONING_UPDATES=1

# Only host-app tests exist; they launch the app.
TEST_CMD=
HOST_TESTS=yes
HOST_TEST_CMD='xcodebuild test -project KeyMinder.xcodeproj -scheme KeyMinder -destination platform=macOS -derivedDataPath "${TMPDIR%/}/KeyMinder-tests.noindex"'

# The build number is the commit count, set by a build phase; the version is bumped by hand.
VERSION_FILES=KeyMinder.xcodeproj/project.pbxproj
CODE_PATHS="KeyMinder KeyMinder.xcodeproj"
TAG_STYLE=vX.Y.Z
BUILD_SOURCE=commitcount

LANGUAGES="en ar bn da de es fi fr he hi id it ja ko nb nl pl pt ru sv th tr vi zh-Hans zh-Hant"
STRINGS_SYNC=translate-missing
# dev reset --deep resets these grants (Input Monitoring covers the double-tap trigger).
TCC_SERVICES="Accessibility ListenEvent"

WEB_SRC=Website
WEB_SITE=app.keyminder
WEB_URL=https://keyminder.app/
# appcast.xml in the Sites copy belongs to release.sh
# (the zips and DMGs there are untracked, so publish leaves them alone anyway).
WEB_KEEP=appcast.xml
