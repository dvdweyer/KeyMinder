TEAM_ID=

# Absolute path to a local clone of dvdweyer/homebrew-tap.
# If set, a stable release (dev release, dev cask update) copies the updated cask there and
# asks before the commit and again before the push.
# Leave blank to update Distribution/Casks/keyminder.rb only (push manually).
# A clone inside this repo (e.g. Homebrew-Tap/) must be ignored, or preflight refuses the
# release over the untracked folder: add /Homebrew-Tap to .git/info/exclude.
TAP_REPO_DIR=

# Cloudflare credentials for cache purging after each release.
# Zone ID: Cloudflare dashboard → keyminder.app → Overview (right sidebar).
# API token: Cloudflare dashboard → My Profile → API Tokens → Create Token
#            (use the "Cache Purge" template, scope to keyminder.app zone).
CF_ZONE_ID=
CF_API_TOKEN=

# Claude API key for scripts/translate-missing.py (fills missing String Catalog entries).
# Only needed when you run the translation step.
ANTHROPIC_API_KEY=
